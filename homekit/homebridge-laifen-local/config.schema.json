{
  "pluginAlias": "LaifenLocal",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {"type": "string", "default": "徕芬大路灯"},
      "python": {"type": "string", "title": "Python path (generated by terminal wizard)"},
      "worker": {"type": "string", "title": "Worker path (generated by terminal wizard)"},
      "bleLog": {"type": "string", "title": "Private BLE log path"},
      "device": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "title": "Exact device name"},
          "protocolAddress": {"type": "string", "title": "Read automatically by wizard; do not guess"},
          "identifier": {"type": "string", "title": "Optional host-local Bluetooth identifier"}
        },
        "required": ["name", "protocolAddress"]
      }
    },
    "required": ["python", "worker", "bleLog", "device"]
  }
}
