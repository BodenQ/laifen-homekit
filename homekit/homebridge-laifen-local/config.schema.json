{
  "pluginAlias": "LaifenLocal",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "default": "徕芬大路灯"
      },
      "python": {
        "type": "string",
        "title": "Python path (generated by terminal wizard)"
      },
      "worker": {
        "type": "string",
        "title": "Worker path (generated by terminal wizard)"
      },
      "bleLog": {
        "type": "string",
        "title": "Private BLE log path"
      },
      "device": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Exact device name"
          },
          "protocolAddress": {
            "type": "string",
            "title": "Read automatically by wizard; do not guess"
          },
          "identifier": {
            "type": "string",
            "title": "Optional host-local Bluetooth identifier"
          }
        },
        "required": [
          "name",
          "protocolAddress"
        ]
      },
      "adaptiveLightingMode": {
        "type": "string",
        "title": "自适应照明色温策略",
        "enum": [
          "apple",
          "independent"
        ],
        "default": "apple",
        "description": "apple：按实际下灯亮度计算；independent：保留 Apple 时间曲线，使用固定参考亮度，真实亮度不变。"
      },
      "adaptiveReferenceBrightness": {
        "type": "number",
        "title": "解耦模式参考亮度 (%)",
        "default": 70,
        "minimum": 1,
        "maximum": 100,
        "description": "仅 independent 模式使用。70 较温和，100 白天更冷；始终遵循 Apple 计划允许的亮度范围。"
      }
    },
    "required": [
      "python",
      "worker",
      "bleLog",
      "device"
    ]
  }
}
